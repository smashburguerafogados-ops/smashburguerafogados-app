rules_version = '2';

// Publish this file in the Firebase console (Firestore → Rules) or with
// `firebase deploy --only firestore:rules`. Until it is published, the
// database may still be in test mode.
//
// A signed-in person can read and write only users/{their uid}.
// Creating a profile through the app must set role "customer".
// role and uid cannot be changed from the client, so nobody can promote
// their own document to admin. Admin documents are written from the
// Firebase console, which bypasses these rules.
//
// categories are public to read. products are public to read only when
// available is true. An admin read is its own rule so the product list
// can listen to the whole collection. Writes, including delete, require
// users/{uid}.role == 'admin'.
//
// settings/shop is public to read so the opening screen can show whether
// the shop is online and the closed message. Only an admin can change it.
// settings/theme is public to read so every customer sees the confirmed
// theme. Only an admin can change it.
//
// faturamento/{orderId} stores the amount once, when an order leaves em
// andamento for finalizado. Admins read it. The create is one-shot: a
// later status change cannot update or delete the recorded amount. An
// admin can record it, and the customer can record their own order after
// it is already finalizado, for the order's own total.
//
// orders: a signed-in customer creates an order for their own uid with
// status "novo". They read only their own orders and may only move one
// from "enviado" to "finalizado". An admin reads and updates every order.
// The admin read is its own rule. Combining it with the customer check
// in one OR makes Firestore reject the admin's collection listener,
// because a list query must be proven by a rule that does not depend on
// a field the query does not filter.
// connection_tests is locked. Everything else is denied.

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function customerCreate(userId) {
      let data = request.resource.data;
      return data.uid == userId
        && data.role == 'customer'
        && data.nome is string
        && data.whatsapp is string
        && data.address is map;
    }

    match /users/{userId} {
      allow read: if signedInAs(userId);
      allow create: if signedInAs(userId) && customerCreate(userId);
      allow update: if signedInAs(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role;
      allow delete: if signedInAs(userId);
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isAdmin();
      allow read: if resource.data.available == true;
      allow write: if isAdmin();
    }

    function orderCreate() {
      let data = request.resource.data;
      return request.auth != null
        && data.customerId == request.auth.uid
        && data.status == 'novo'
        && data.reason == ''
        && data.customerName is string
        && data.customerWhatsapp is string
        && data.totalCents is int
        && data.totalCents > 0
        && data.items is list
        && data.items.size() > 0
        && data.items.size() <= 50
        && data.payment is map
        && data.payment.method in ['pix', 'cartao', 'dinheiro'];
    }

    function customerFinishes() {
      return request.auth != null
        && resource.data.customerId == request.auth.uid
        && resource.data.status == 'enviado'
        && request.resource.data.status == 'finalizado'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
    }

    match /orders/{orderId} {
      allow read: if isAdmin();
      allow read: if request.auth != null && resource.data.customerId == request.auth.uid;
      allow create: if orderCreate();
      allow update: if isAdmin() || customerFinishes();
      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if settingId == 'shop' || settingId == 'theme';
      allow write: if (settingId == 'shop' || settingId == 'theme') && isAdmin();
    }

    function revenueCreate(orderId) {
      let data = request.resource.data;
      let order = get(/databases/$(database)/documents/orders/$(orderId)).data;
      return data.orderId == orderId
        && data.totalCents == order.totalCents
        && data.totalCents is int
        && data.totalCents > 0
        && data.finalizedAtMs is int
        && order.status == 'finalizado'
        && (isAdmin() || (request.auth != null && order.customerId == request.auth.uid));
    }

    match /faturamento/{orderId} {
      allow read: if isAdmin();
      allow create: if revenueCreate(orderId);
      allow update, delete: if false;
    }

    match /connection_tests/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
