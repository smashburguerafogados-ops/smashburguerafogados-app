rules_version = '2';

// Publish this file in the Firebase console (Firestore → Rules) or with
// `firebase deploy --only firestore:rules`. Until it is published, the
// database may still be in test mode.
//
// A signed-in person can read and write only users/{their uid}.
// An admin read is its own rule so Contato can list every customer.
// Combining that with the own-document check in one OR makes Firestore
// reject the admin's collection listener.
// Creating a profile through the app must set role "customer".
// role and uid cannot be changed from the client, so nobody can promote
// their own document to admin. Admin documents are written from the
// Firebase console, which bypasses these rules.
//
// categories are public to read. products are public to read only when
// available is true. An admin read is its own rule so the product list
// can listen to the whole collection. Writes, including delete, require
// users/{uid}.role == 'admin'.
//
// productPhotos/{productId} holds one product photo, so the menu lists names
// and prices without downloading every photo first. Anyone can get one photo
// by id; only an admin can list the collection or write it. products/{id}
// .photoVersion points at it. Products saved before this rule keep the photo
// in products/{id}.image, and the app still reads that.
// productPhotoBackups/{productId} is the admin-only copy taken before a photo
// leaves its product, for the undo.
//
// addons is the shared add-on catalog: name and price only. Everyone can
// read it. Only an admin can write it. The public read is its own rule.
// It is not combined with an admin check in one OR.
//
// settings/shop is public to read so the opening screen can show whether
// the shop is online and the closed message. Only an admin can change it.
// settings/theme is public to read so every customer sees the confirmed
// theme. Only an admin can change it.
// settings/raffle is public to read so the customer menu can show the
// hourglass and the order note. Only an admin writes the title, the day,
// and the winner. A customer records only their own dismissal.
// settings/catalog is admin-only. It records that product extras were
// copied into the add-on catalog once. Customers do not read it.
//
// faturamento/{orderId} stores the amount once, when an order leaves em
// andamento for finalizado. Admins read it. The create is one-shot: a
// later status change cannot update or delete the recorded amount. An
// admin can record it, and the customer can record their own order after
// it is already finalizado, for the order's own total.
//
// orders: a signed-in customer creates an order for their own uid with
// status "novo". They read only their own orders and may only move one
// from "enviado" to "finalizado". An admin reads and updates every order.
// The admin read is its own rule. Combining it with the customer check
// in one OR makes Firestore reject the admin's collection listener,
// because a list query must be proven by a rule that does not depend on
// a field the query does not filter.
//
// blocked/{55DDDnúmero} is the list of phones that cannot order. The id is
// the normalized phone digits, the same digits the customer login email is
// built from. A signed-in person can read one document by id (get) so the app
// can check a phone, but nobody except an admin can list the collection. Only
// an admin writes it. The admin's private note lives in blockedNotes/{same id},
// admin-only, so a blocked customer never reads it.
// Creating an order is denied when the signed-in login's phone, taken from the
// token email and not from any field the client sends, is blocked, or when
// customerWhatsapp is blocked. Reading the menu stays public: categories,
// products, addons and settings are open to people who are not signed in, so
// no rule can keep a blocked phone out of the menu. The app hides it instead.
// A blocked number can still sign in with a different phone.
// Opening hours: creating an order is denied outside the weekly schedule saved
// in settings/shop.schedule. The server decides with its own clock, in Recife
// time (UTC-3, no daylight saving), so a wrong clock on the customer's phone
// cannot place an order after closing. With no schedule saved, the default is
// 16:00 to 23:00 every day except Wednesday. 23:00 sharp is already closed.
// Each day is { open: bool, from: minutes, to: minutes } with the day keys
// mon, tue, wed, thu, fri, sat, sun. The manual Online switch is only checked
// by the app, not here.
// connection_tests is locked. Everything else is denied.

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function phoneIsBlocked(phone) {
      return exists(/databases/$(database)/documents/blocked/$(phone));
    }

    function loginPhone() {
      return request.auth.token.email.split('[.@]')[0];
    }

    function loginIsBlocked() {
      return request.auth != null
        && 'email' in request.auth.token
        && phoneIsBlocked(loginPhone());
    }

    function recifeNow() {
      return request.time - duration.time(3, 0, 0, 0);
    }

    function shopDay() {
      return ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'][recifeNow().dayOfWeek() - 1];
    }

    function shopSettings() {
      return exists(/databases/$(database)/documents/settings/shop)
        ? get(/databases/$(database)/documents/settings/shop).data
        : {};
    }

    function shopIsOpen() {
      let day = shopDay();
      let entry = shopSettings().get('schedule', {}).get(day, {});
      let minute = recifeNow().hours() * 60 + recifeNow().minutes();
      return entry.get('open', day != 'wed')
        && minute >= entry.get('from', 960)
        && minute < entry.get('to', 1380);
    }

    function customerCreate(userId) {
      let data = request.resource.data;
      return data.uid == userId
        && data.role == 'customer'
        && data.nome is string
        && data.whatsapp is string
        && data.address is map;
    }

    match /users/{userId} {
      allow read: if isAdmin();
      allow read: if signedInAs(userId);
      allow create: if signedInAs(userId) && customerCreate(userId);
      allow update: if signedInAs(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role;
      allow delete: if signedInAs(userId);
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    function addonWrite() {
      let data = request.resource.data;
      return isAdmin()
        && data.keys().hasOnly(['name', 'price'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.price is number
        && data.price > 0;
    }

    match /addons/{addonId} {
      allow read: if true;
      allow create, update: if addonWrite();
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isAdmin();
      allow read: if resource.data.available == true;
      allow write: if isAdmin();
    }

    function photoWrite() {
      let data = request.resource.data;
      return isAdmin()
        && data.keys().hasOnly(['image', 'updatedAtMs'])
        && data.image is string
        && data.image.size() > 0
        && data.image.size() <= 1000000
        && data.updatedAtMs is int;
    }

    match /productPhotos/{productId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if photoWrite();
      allow delete: if isAdmin();
    }

    match /productPhotoBackups/{productId} {
      allow read, write: if isAdmin();
    }

    function orderCreate() {
      let data = request.resource.data;
      return request.auth != null
        && data.customerId == request.auth.uid
        && data.status == 'novo'
        && data.reason == ''
        && data.customerName is string
        && data.customerWhatsapp is string
        && data.totalCents is int
        && data.totalCents > 0
        && data.items is list
        && data.items.size() > 0
        && data.items.size() <= 50
        && data.payment is map
        && data.payment.method in ['pix', 'cartao', 'dinheiro']
        && !loginIsBlocked()
        && !phoneIsBlocked(data.customerWhatsapp)
        && shopIsOpen();
    }

    function customerFinishes() {
      return request.auth != null
        && resource.data.customerId == request.auth.uid
        && resource.data.status == 'enviado'
        && request.resource.data.status == 'finalizado'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
    }

    match /orders/{orderId} {
      allow read: if isAdmin();
      allow read: if request.auth != null && resource.data.customerId == request.auth.uid;
      allow create: if orderCreate();
      allow update: if isAdmin() || customerFinishes();
      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if settingId == 'shop' || settingId == 'theme' || settingId == 'raffle';
      allow read: if settingId == 'catalog' && isAdmin();
      allow write: if (settingId == 'shop' || settingId == 'theme' || settingId == 'raffle') && isAdmin();
      allow write: if settingId == 'catalog' && isAdmin();
    }

    match /raffleDismissals/{dismissalId} {
      allow read: if isAdmin();
      allow read: if request.auth != null && resource.data.customerId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.day is string
        && dismissalId == request.auth.uid + '_' + request.resource.data.day;
      allow update, delete: if false;
    }

    function revenueCreate(orderId) {
      let data = request.resource.data;
      let order = get(/databases/$(database)/documents/orders/$(orderId)).data;
      return data.orderId == orderId
        && data.totalCents == order.totalCents
        && data.totalCents is int
        && data.totalCents > 0
        && data.finalizedAtMs is int
        && order.status == 'finalizado'
        && (isAdmin() || (request.auth != null && order.customerId == request.auth.uid));
    }

    match /faturamento/{orderId} {
      allow read: if isAdmin();
      allow create: if revenueCreate(orderId);
      allow update, delete: if false;
    }

    match /blocked/{phone} {
      allow read: if isAdmin();
      allow get: if request.auth != null;
      allow write: if isAdmin();
    }

    match /blockedNotes/{phone} {
      allow read, write: if isAdmin();
    }

    match /connection_tests/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
