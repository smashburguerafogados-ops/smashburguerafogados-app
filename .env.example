# Public Firebase web client config. These identifiers ship in the browser.
# They are not server secrets. Access is limited by Firebase Auth, authorized
# domains, and firestore.rules. Do not add private keys or service accounts here.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
